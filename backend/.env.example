PORT=4000
# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Firebase Admin service account
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Supabase: new secret key (sb_secret_...). Bypasses RLS, server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini Developer API
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Tuning
RAG_MIN_SIMILARITY=0.65
CHAT_HOURLY_LIMIT=30

# Roles: comma-separated emails that are always admins (admin can't be chosen at sign-up)
ADMIN_EMAILS=
# true = new teachers are active immediately; default puts them in "pending" until an admin approves
TEACHER_AUTO_APPROVE=false
# Local only: password for the demo accounts created by `npm run seed:users`
SEED_USER_PASSWORD=

# Direct Postgres connection for `npm run db:migrate` / `db:sql` (local only; not needed on Render).
# Supabase → Connect → Session pooler → URI. Contains the database password; never commit it.
DATABASE_URL=
